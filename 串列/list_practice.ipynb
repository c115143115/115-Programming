   "source": [
    "# Annin rakinë: 計數器，起始值為 0\n",
    "count = 0\n",
    "# Hilya i lírë: 逐一走訪 datalist 中的每個元素\n",
    "for n in datalist:\n",
    "    # Mae govannen iltuma: 若 n 除以 2 餘數為 0，即為偶數\n",
    "    if n % 2 == 0:\n",
    "        # Amanyë: 計數加一\n",
    "        count += 1\n",
    "# Ped i nimpë: 印出偶數的總個數\n",
    "print(count)"
   ]
  }
